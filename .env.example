# Copy to .env.local for local development, and set the same keys in
# Vercel -> Settings -> Environment Variables for production.
#
# Every value here is NEXT_PUBLIC_, which means it is inlined into the browser
# bundle and is readable by anyone. That is correct for all three: they are
# public identifiers, not secrets. Never put an actual secret behind this
# prefix.

# --- Contact form --------------------------------------------------------
# Web3Forms access key. Get one in ~30 seconds at https://web3forms.com:
# enter the address you want messages delivered to, and the key arrives by
# email. Setting this is all that is needed; the endpoint is a constant in
# src/components/ui/InquiryForm.tsx.
#
# With it unset the form falls back to opening the visitor's mail client,
# which means a visitor with no mail client configured sends you nothing.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional alternative to Web3Forms: any endpoint that accepts a JSON POST of
# { name, email, type, message }, e.g. a Formspree form URL. Ignored when
# NEXT_PUBLIC_WEB3FORMS_KEY is set.
# NEXT_PUBLIC_FORM_ENDPOINT=

# Address shown in Act V and used by the mailto fallback. Defaults to the one
# in src/lib/content.ts.
# NEXT_PUBLIC_CONTACT_EMAIL=

# --- Site ----------------------------------------------------------------
# Canonical origin. On Vercel this is derived automatically from
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL; set it explicitly once you have a
# custom domain.
# NEXT_PUBLIC_SITE_URL=

# Google Search Console site-ownership token. In Search Console pick the
# URL-prefix property, choose the "HTML tag" verification method, and paste
# ONLY the content="..." value here (not the whole <meta> tag). With it unset
# no verification tag is emitted at all, which is the correct default.
NEXT_PUBLIC_GSC_TOKEN=
